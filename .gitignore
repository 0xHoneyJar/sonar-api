# Envio codegen output. Both are rebuilt by `envio codegen`, and `.envio/types.d.ts`
# is what makes `tsc --noEmit` pass — absent it, every `envio` import is untyped.
.envio/
envio-env.d.ts
generated

# ReScript/OCaml intermediates from the Envio toolchain
*.cmi
*.cmj
*.cmt
*.cmti
*.res.js
*.res.mjs
*.gen.ts

# Build + test output
build/
dist/
out/
lib/
coverage/
*.log

# Dependencies
node_modules/

# Secrets — never commit any local env file
.env
.env.*
!.env.example

# Editor + OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local agent/session state. None of it is part of the indexer; it is written by
# tooling that runs against this repo and is meaningless to anyone else.
.claude/
.beads/
.goalrun/
.run/
.repos/
grimoires/

# Temporary
tmp/
temp/
*.tmp
*.bak
