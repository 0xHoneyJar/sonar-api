# Normalize line endings so a checkout on another platform does not rewrite
# every file. Shell scripts must stay LF or they fail inside the Linux image.
* text=auto
*.sh text eol=lf

# Binary — never diff or line-ending-convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Better diff hunk headers.
*.md diff=markdown
*.json diff=json

# Generated — collapsed in review, because the source of truth is elsewhere.
# config.yaml comes from src/registry/*.ts (`pnpm gen:config`), the lockfile from
# package.json. Reading either by hand is not the check; `pnpm test` is.
config.yaml linguist-generated=true
pnpm-lock.yaml linguist-generated=true
