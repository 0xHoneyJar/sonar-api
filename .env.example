# Envio API token — https://envio.dev/app/api-tokens
# The only credential this repo needs. Required for `envio codegen` and `envio dev`.
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# Optional. Points scripts/verify-belt-contract.mjs at a specific GraphQL endpoint
# instead of the default in scripts/belt-contract.json — use it to check a new
# deployment before switching any consumer over to it.
# BELT_GATEWAY_ENDPOINT=https://<deployment>/v1/graphql
